{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(poetry install)",
      "Bash(poetry check *)",
      "Bash(poetry show *)",
      "Bash(poetry env info *)",
      "Bash(poetry run python seed.py)",
      "Bash(poetry run python -m tests.test_ollama_embed)",
      "Bash(poetry run uvicorn src.proxy.main:app *)",
      "Bash(poetry run pytest)",
      "Bash(poetry run pytest -q)",
      "Bash(poetry run locust --version)",
      "Bash(.claude/skills/run-aegis-guard/smoke.sh *)",
      "Bash(curl -s http://localhost:8000/health)",
      "Bash(curl -s http://localhost:8000/metrics)",
      "Bash(curl -s http://localhost:11434/api/tags)",
      "Bash(terraform -chdir=terraform fmt *)",
      "Bash(terraform -chdir=terraform validate *)",
      "Bash(terraform -chdir=terraform version *)",
      "Bash(terraform -chdir=terraform providers)",
      "Bash(terraform -chdir=terraform state list *)",
      "Bash(terraform -chdir=terraform output *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(ollama --version)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh repo view *)"
    ],
    "ask": [
      "Bash(terraform plan *)",
      "Bash(terraform *plan*)",
      "Bash(terraform apply *)",
      "Bash(terraform *apply*)",
      "Bash(terraform destroy *)",
      "Bash(terraform *destroy*)",
      "Bash(terraform import *)",
      "Bash(terraform *import*)",
      "Bash(terraform refresh *)",
      "Bash(terraform *refresh*)",
      "Bash(terraform init *)",
      "Bash(terraform *init*)",
      "Bash(terraform taint *)",
      "Bash(terraform untaint *)",
      "Bash(terraform *taint*)",
      "Bash(terraform show *)",
      "Bash(terraform *show*)",
      "Bash(terraform console *)",
      "Bash(terraform *console*)",
      "Bash(terraform force-unlock *)",
      "Bash(terraform *force-unlock*)",
      "Bash(terraform state rm *)",
      "Bash(terraform *state rm*)",
      "Bash(terraform state mv *)",
      "Bash(terraform *state mv*)",
      "Bash(terraform state push *)",
      "Bash(terraform *state push*)",
      "Bash(terraform state pull *)",
      "Bash(terraform *state pull*)",
      "Bash(terraform state replace-provider *)",
      "Bash(terraform *state replace-provider*)",
      "Bash(terraform *providers lock*)",
      "Bash(terraform *providers mirror*)",
      "Bash(aws *)",
      "Bash(docker login *)",
      "Bash(docker push *)",
      "Bash(docker image push *)",
      "Bash(docker build*push*)",
      "Bash(docker build*type=registry*)",
      "Bash(docker compose push *)",
      "Bash(docker compose build*push*)",
      "Bash(docker compose config *)",
      "Bash(docker compose convert*)",
      "Bash(docker inspect *)",
      "Bash(docker container inspect *)",
      "Bash(docker exec *)",
      "Bash(docker container exec *)",
      "Bash(docker compose exec *)",
      "Bash(git push *)",
      "Bash(git -C * push*)",
      "Bash(git -c * push*)",
      "Bash(git clean *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr review *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr ready *)",
      "Bash(gh pr close *)",
      "Bash(gh pr reopen *)",
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue close *)",
      "Bash(gh issue reopen *)",
      "Bash(gh issue delete *)",
      "Bash(gh issue transfer *)",
      "Bash(gh issue develop *)",
      "Bash(gh label *)",
      "Bash(gh release *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo delete *)",
      "Bash(gh gist *)",
      "Bash(gh secret *)",
      "Bash(gh workflow run *)",
      "Bash(gh api *)",
      "Bash(poetry add *)",
      "Bash(poetry * add *)",
      "Bash(poetry remove *)",
      "Bash(poetry * remove *)",
      "Bash(poetry lock *)",
      "Bash(poetry * lock*)",
      "Bash(poetry update *)",
      "Bash(poetry * update*)",
      "Bash(poetry run uvicorn *--host*)",
      "Bash(rm *.db*)",
      "Bash(rm *vector_store*)",
      "Bash(rm *tfstate*)",
      "Bash(ollama serve*)",
      "Bash(ollama run *)",
      "Bash(ollama pull *)",
      "Bash(ollama rm *)"
    ],
    "deny": [
      "Read(/.env)",
      "Read(**/.env)",
      "Read(/terraform/*.tfstate)",
      "Read(/terraform/*.tfstate.*)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(**/*.tfvars)",
      "Read(**/*.tfvars.json)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git -C * add *)",
      "Bash(git -C * commit *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/post-edit-check.sh",
            "args": [],
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-context.sh",
            "args": [],
            "timeout": 15
          }
        ]
      }
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  }
}
